.header {
  margin-bottom: 40rpx;
}
.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #111827;
  display: block;
}
.subtitle {
  font-size: 28rpx;
  color: #6b7280;
}
.form-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05);
}
.form-group {
  margin-bottom: 40rpx;
}
.label {
  font-size: 28rpx;
  font-weight: 500;
  color: #374151;
  display: block;
  margin-bottom: 20rpx;
}
.subject-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}
.subject-item {
  width: 47%;
  padding: 24rpx 0;
  text-align: center;
  border: 2rpx solid #e5e7eb;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #4b5563;
  background: #f9fafb;
}
.subject-item.active {
  border-color: #6366f1;
  background: #eef2ff;
  color: #4338ca;
  font-weight: 500;
}
.input-field {
  border: 2rpx solid #e5e7eb;
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 28rpx;
}
.textarea-field {
  border: 2rpx solid #e5e7eb;
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 28rpx;
  width: 100%;
  box-sizing: border-box;
  height: 200rpx;
}
.level-grid {
  display: flex;
  justify-content: space-between;
}
.level-item {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #f3f4f6;
  color: #6b7280;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 500;
}
.level-item.active {
  background: #4f46e5;
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(79,70,229,0.3);
}
.submit-btn {
  background: #4f46e5;
  color: #fff;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
  padding: 24rpx 0;
  margin-top: 40rpx;
}
